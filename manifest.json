{
  "manifest_version": 3,
  "name": "XWise Blocker",
  "version": "3.1.1",
  "description": "Ultimate content filter, timeline cleaner, ad blocker, pro video suite, and native moderation for X (Twitter).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XWise Blocker v3.1.1 Pro"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "downloads", "alarms", "cookies"],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": [
        "modules/cache.js",
        "modules/twitterApi.js",
        "modules/relationshipTracker.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modules/cache.js",
        "modules/twitterApi.js",
        "modules/relationshipTracker.js",
        "fonts/vazirmatn-arabic.woff2",
        "fonts/vazirmatn-latin-ext.woff2",
        "fonts/vazirmatn-latin.woff2",
        "popup.html",
        "popup.css",
        "popup.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"]
    }
  ]
}
