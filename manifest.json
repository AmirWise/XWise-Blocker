{
  "manifest_version": 3,
  "name": "XWise Blocker",
  "version": "2.0.0",
  "description": "Smart content filtering for X: keyword, emoji, and pattern rules with dry-run preview, per-scope matching, and native-feeling UI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XWise Blocker settings"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/vazirmatn-arabic.woff2", "fonts/vazirmatn-latin-ext.woff2", "fonts/vazirmatn-latin.woff2"],
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"]
    }
  ]
}